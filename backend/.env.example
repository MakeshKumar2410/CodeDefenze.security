# Copy this file to .env and fill in real values before running the server.

# Port the backend API runs on
PORT=5000

# ---- Email (via Resend — https://resend.com) ----
# Sign up at resend.com, verify a sending domain (or use their test domain
# while developing), and create an API key.
RESEND_API_KEY=your_resend_api_key
# Must be an address/domain verified in your Resend account.
EMAIL_FROM=notifications@your-domain.com
# Where contact/enrollment notification emails are sent.
TO_EMAIL=your-email@example.com

# ---- Telegram bot notifications (contact + enrollment submissions) ----
# Create a bot via @BotFather to get a token, and message the bot once so
# you can look up your chat id (e.g. via the getUpdates API or @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Long random string used to sign admin login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Used once by `npm run seed:admin` to create your first admin login.
# You can change your password later from the admin panel (or re-run the seed script).
ADMIN_SEED_EMAIL=admin@codedefenze.security
ADMIN_SEED_PASSWORD=change-this-password

# Comma-separated list of origins allowed to call this API with credentials
# (your frontend dev server and your admin panel dev server / production URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Storage provider ----
# Which backend actually stores/serves course video files right now.
# 'google_drive' is active and implemented. 'r2' is prepared in code but
# NOT implemented/activated yet — do not set this to r2 until R2StorageService
# is finished (see backend/lib/storage/r2Storage.js).
STORAGE_PROVIDER=google_drive

# ---- Google Drive (active video storage) ----
# See README.md "Google Drive setup" section for the full step-by-step
# walkthrough to get these four values from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
# The Drive folder ID of your top-level "CodeDefenze" folder (the ID in
# its URL after /folders/). Course/Day subfolders are created automatically
# underneath it.
GOOGLE_DRIVE_FOLDER_ID=

# ---- Cloudflare R2 (prepared only — not active, not required) ----
# Leave these blank. Filling them in does nothing until R2StorageService
# is actually implemented and STORAGE_PROVIDER is set to r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---- Database (not active yet) ----
# Reserved for a future move from the current JSON file (backend/data/db.json)
# to Postgres. Leaving this blank changes nothing today — see README.md for
# the planned migration path.
DATABASE_URL=
